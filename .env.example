PORT=5200
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://192.168.10.112

# SQL Server (mismo servidor que el SGD). Acepta "servidor\instancia".
DB_SERVER=antivirus\prdamapolasql
DB_USER=sa
DB_PASSWORD=cambiar
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Bases de datos
DB_AMAPOLANET=amapolanet   # usuarios, extensiones, eventos, papelería, relación de gastos
DB_CAA=CAA                 # solicitudes, formatos y lo demás

# SPI (Oracle) — nómina: búsqueda de trabajadores por cédula
SPI_USER=INFOCENT
SPI_PASSWORD=cambiar
SPI_CONNECT=192.168.10.141/SPI
# Solo si aparece el error NJS-138 (Oracle anterior a 12.1): carpeta de Oracle Instant Client
# ORACLE_CLIENT_DIR=C:\oracle\instantclient_21_13

# Servidor de la Intrapola actual (imágenes de banners y comunicados existentes)
LEGACY_BASE_URL=http://192.168.10.112
LEGACY_APP_PATH=intrapola   # carpeta de la app en el IIS (para rutas "~/...")

# Correo (conector de Office 365, igual que la Intrapola actual: autoriza por la IP del servidor)
SMTP_HOST=industriasamapola-com.mail.protection.outlook.com
SMTP_PORT=25
# SMTP_FROM: el mismo valor de SmtpUser del web.config de la Intrapola (sin comentarios en la misma línea)
SMTP_FROM=
SMTP_EHLO=industriasamapola.com
SMTP_DEBUG=false
CORREO_RRHH=satrrhh@industriasamapola.com
CORREO_SISTEMAS=sistemas.amapola@industriasamapola.com
# Adjuntos de soporte (subcarpeta por usuario, como hoy)
SOPORTE_ADJUNTOS=\\192.168.10.123\tudirectorioenelservidor
CORREO_MATERIALES_SAP=arepuestos@industriasamapola.com
CORREO_ANTICIPOS=yromero@industriasamapola.com,cramirez@industriasamapola.com

# Anticipo de prestaciones
DB_ASISTENCIA=Asistencia-Amapola
# Carpeta de las planillas ({anio} y {mes} se reemplazan; el usuario que corre la API necesita acceso al recurso compartido)
ANTICIPOS_CARPETA=\\192.168.10.106\gr_rrhh$\Nóminas\Nominas Año {anio}\Abonos de Prestaciones Sociales\{mes}
# Texto largo y aleatorio para firmar las sesiones del portal de anticipos
ANTICIPOS_SECRETO=

# Formatos fijos en PDF (ruta en el servidor)
FORMATO_REEMBOLSO_SEGURO=assets/formatos/reembolso-seguro.pdf

UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10

# Panel de administración (/admin en la Intrapola): un solo usuario
ADMIN_USUARIO=admin
ADMIN_CLAVE=
# Firma de las sesiones del panel (texto largo al azar). Si se deja vacío, las sesiones se pierden al reiniciar
ADMIN_SECRETO=
# Carpeta de los PDF de normas y archivo donde se guardan los colores
NORMAS_DIR=assets/normas
TEMA_ARCHIVO=datos/tema.json
# Datos de la empresa y otros textos editables desde el panel
DATOS_DIR=datos

# Token para scripts/integraciones (encabezado x-admin-token); el panel usa ADMIN_USUARIO/ADMIN_CLAVE
ADMIN_TOKEN=

# Opcional: servir el frontend compilado desde este mismo proceso (un solo puerto en el servidor)
# FRONTEND_DIST=../frontend/dist
# Subcarpeta donde se publica todo (debe coincidir con VITE_BASE del frontend)
# BASE_PATH=/intrapola

# Apolin (asistente virtual). Sin IA configurada funciona solo con el menú guiado.
# Preguntas generales: primero la nube y, si se acaba la cuota o falla, Ollama en el servidor.
APOLIN_IA_ORDEN=nube,local
# Nube: cualquier servicio compatible con la API de OpenAI. Ejemplo con Groq (plan gratis):
#   APOLIN_NUBE_URL=https://api.groq.com/openai/v1   APOLIN_NUBE_MODELO=openai/gpt-oss-20b
# Gemini:  APOLIN_NUBE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter (modelos :free): APOLIN_NUBE_URL=https://openrouter.ai/api/v1
APOLIN_NUBE_NOMBRE=Groq
APOLIN_NUBE_URL=
APOLIN_NUBE_CLAVE=
APOLIN_NUBE_MODELO=
# Ollama en este servidor (respaldo): APOLIN_OLLAMA_URL=http://127.0.0.1:11434
APOLIN_OLLAMA_URL=
APOLIN_OLLAMA_MODELO=llama3.2
# Preguntas generales por persona al día, largo máximo de la respuesta y espera máxima
APOLIN_PREGUNTAS_DIA=25
APOLIN_MAX_TOKENS=900
APOLIN_IA_TIMEOUT_MS=90000
# Encuesta de satisfacción del SAT ({id} = número de ticket)
APOLIN_URL_ENCUESTA=http://192.168.10.112/Sat/sistemas/encuesta_sastifacion_sistemas.aspx?key={id}
