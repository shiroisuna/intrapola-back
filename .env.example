PORT=5200
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://192.168.10.112

# SQL Server (mismo servidor que el SGD). Acepta "servidor\instancia".
DB_SERVER=antivirus\prdamapolasql
DB_USER=sa
DB_PASSWORD=cambiar
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Bases de datos
DB_AMAPOLANET=amapolanet   # usuarios, extensiones, eventos, papelería, relación de gastos
DB_CAA=CAA                 # solicitudes, formatos y lo demás

# SPI (Oracle) — nómina: búsqueda de trabajadores por cédula
SPI_USER=INFOCENT
SPI_PASSWORD=cambiar
SPI_CONNECT=192.168.10.141/SPI
# Solo si aparece el error NJS-138 (Oracle anterior a 12.1): carpeta de Oracle Instant Client
# ORACLE_CLIENT_DIR=C:\oracle\instantclient_21_13

# Servidor de la Intrapola actual (imágenes de banners y comunicados existentes)
LEGACY_BASE_URL=http://192.168.10.112
LEGACY_APP_PATH=intrapola   # carpeta de la app en el IIS (para rutas "~/...")

# Correo (conector de Office 365, igual que la Intrapola actual: autoriza por la IP del servidor)
SMTP_HOST=industriasamapola-com.mail.protection.outlook.com
SMTP_PORT=25
SMTP_FROM=          # el mismo valor de SmtpUser del web.config de la Intrapola
CORREO_RRHH=satrrhh@industriasamapola.com
CORREO_SISTEMAS=sistemas.amapola@industriasamapola.com
# Adjuntos de soporte (subcarpeta por usuario, como hoy)
SOPORTE_ADJUNTOS=\\192.168.10.123\tudirectorioenelservidor
CORREO_ANTICIPOS=yromero@industriasamapola.com,cramirez@industriasamapola.com

# Anticipo de prestaciones
DB_ASISTENCIA=Asistencia-Amapola
# Carpeta de las planillas ({anio} y {mes} se reemplazan; el usuario que corre la API necesita acceso al recurso compartido)
ANTICIPOS_CARPETA=\\192.168.10.106\gr_rrhh$\Nóminas\Nominas Año {anio}\Abonos de Prestaciones Sociales\{mes}
# Texto largo y aleatorio para firmar las sesiones del portal de anticipos
ANTICIPOS_SECRETO=

UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10

# Token para cambiar estados de solicitudes y publicar documentos (encabezado x-admin-token)
ADMIN_TOKEN=

# Opcional: ruta al build del frontend para servir todo en un solo puerto
# FRONTEND_DIST=../frontend/dist
